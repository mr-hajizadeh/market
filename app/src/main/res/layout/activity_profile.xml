<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_gray"
    tools:context=".Activity.ProfileActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:layoutDirection="rtl"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="24dp">

                <ImageView
                    android:id="@+id/backBtn"
                    style="@style/customNavigateButton"
                    android:layout_width="@dimen/navigate_button"
                    android:layout_height="@dimen/navigate_button"
                    android:contentDescription="@string/title_my_address"
                    android:src="@drawable/ic_arrow_left"
                    app:layout_constraintBottom_toBottomOf="@+id/textView2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/textView2" />

                <TextView
                    android:id="@+id/textView2"
                    style="@style/customTextTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/title_profile"
                    app:layout_constraintEnd_toStartOf="@+id/backBtn"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </LinearLayout>

            <TextView
                android:id="@+id/textView16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:text="@string/title_first_name"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

            <EditText
                android:id="@+id/firstnameEdt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/input_bg"
                android:ems="10"
                android:fontFamily="@font/vazir"
                android:hint="@string/hint_first_name"
                android:inputType="text"
                android:lines="1"
                android:maxLines="1"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/text_color"
                android:textColorHint="@color/secondary_gray"
                tools:ignore="Autofill"
                tools:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/textView17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:text="@string/title_last_name"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

            <EditText
                android:id="@+id/lastnameEdt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/input_bg"
                android:ems="10"
                android:fontFamily="@font/vazir"
                android:hint="@string/hint_last_name"
                android:inputType="text"
                android:lines="1"
                android:maxLines="1"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/text_color"
                android:textColorHint="@color/secondary_gray"
                tools:ignore="Autofill"
                tools:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/textView18"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:text="@string/title_birthday_date"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

            <TextView
                android:id="@+id/birthdayTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/input_bg"
                android:fontFamily="@font/vazir"
                android:inputType="none"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/text_color"
                android:textColorHint="@color/secondary_gray"
                app:drawableStartCompat="@drawable/ic_calendar"
                tools:ignore="Autofill"
                tools:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/textView21"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:text="@string/title_email"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

            <EditText
                android:id="@+id/emailEdt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/input_bg"
                android:fontFamily="@font/vazir"
                android:hint="@string/hint_email"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/text_color"
                android:textColorHint="@color/secondary_gray"
                tools:ignore="Autofill"
                tools:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/textView22"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:text="@string/title_gender"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/maleRd"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/radio_button_size"
                    android:layout_marginStart="8dp"
                    android:layout_weight="0.333"
                    android:background="@drawable/radio_bg"
                    android:button="@null"
                    android:checked="true"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:layoutDirection="rtl"
                    android:paddingHorizontal="16dp"
                    android:text="@string/title_male"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="@drawable/selector_radio_text" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/femaleRd"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/radio_button_size"
                    android:layout_weight="0.333"
                    android:background="@drawable/radio_bg"
                    android:button="@null"
                    android:drawablePadding="6dp"
                    android:gravity="center"
                    android:layoutDirection="rtl"
                    android:paddingHorizontal="16dp"
                    android:text="@string/title_female"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="@drawable/selector_radio_text" />
            </RadioGroup>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/submitBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/vazir"
        android:text="@string/title_submit_changes"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>