<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:id="@+id/closeBtn"
            style="@style/customNavigateButton"
            android:layout_width="@dimen/navigate_button"
            android:layout_height="@dimen/navigate_button"
            android:contentDescription="@string/title_submit_location"
            android:padding="6dp"
            app:srcCompat="@drawable/ic_close" />

        <TextView
            android:id="@+id/textView4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/title_permission_denied"
            android:textColor="@color/black" />

    </LinearLayout>

    <TextView
        android:id="@+id/textView12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:justificationMode="inter_word"
        android:lineHeight="18dp"
        android:textSize="13sp"
        android:text="@string/permission_denied_message"
        tools:ignore="UnusedAttribute" />

    <Button
        android:id="@+id/positiveBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="16dp"
        android:text="@string/title_i_understand" />

</LinearLayout>