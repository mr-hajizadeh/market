<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/shopTypeTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="@string/title_supermarket"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="@color/green"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/shopNameTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" - قائم"
        app:layout_constraintBottom_toBottomOf="@+id/shopTypeTxt"
        app:layout_constraintStart_toEndOf="@+id/shopTypeTxt"
        app:layout_constraintTop_toTopOf="@+id/shopTypeTxt" />

    <TextView
        android:id="@+id/courierFeeTxt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
        app:layout_constraintStart_toEndOf="@+id/imageView14"
        app:layout_constraintTop_toBottomOf="@+id/shopTypeTxt"
        tools:text="رایگان" />

    <ImageView
        android:id="@+id/imageView11"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/courierFeeTxt"
        app:layout_constraintStart_toEndOf="@+id/courierFeeTxt"
        app:layout_constraintTop_toTopOf="@+id/courierFeeTxt"
        app:srcCompat="@drawable/ic_wallet" />

    <TextView
        android:id="@+id/deliveryTimeTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
        app:layout_constraintBottom_toBottomOf="@+id/courierFeeTxt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/courierFeeTxt"
        tools:text="تحویل در 35 دقیقه" />

    <ImageView
        android:id="@+id/imageView14"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/deliveryTimeTxt"
        app:layout_constraintStart_toEndOf="@+id/deliveryTimeTxt"
        app:layout_constraintTop_toTopOf="@+id/deliveryTimeTxt"
        app:srcCompat="@drawable/ic_energie" />

    <TextView
        android:id="@+id/shopBtn"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginEnd="16dp"
        android:text="@string/title_see_all"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        app:drawableLeftCompat="@drawable/ic_arrow_left"
        app:layout_constraintBottom_toBottomOf="@+id/deliveryTimeTxt"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/productView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/courierFeeTxt"
        tools:listitem="@layout/view_holder_product" />
</androidx.constraintlayout.widget.ConstraintLayout>