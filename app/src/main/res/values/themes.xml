<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Market" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/green</item>
        <item name="colorPrimaryVariant">@color/green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/primary_gray</item>
<!--        <item name="android:windowBackground">@color/gray</item>-->
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->

        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigationView</item>
        <item name="android:textViewStyle">@style/CustomTextView</item>

    </style>

    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.BottomNavigationView</item>
    </style>

    <style name="ThemeOverlay.App.BottomNavigationView" parent="">
        <item name="colorSurface">@color/primary_gray</item>
        <item name="colorOnSecondaryContainer">@color/green</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorOnSurface">@color/green</item>
        <item name="itemTextAppearanceInactive">@style/CustomBottomNavTextAppearance</item>
        <item name="itemTextAppearanceActive">@style/CustomBottomNavTextAppearance</item>
    </style>

    <style name="CustomBottomNavTextAppearance" parent="TextAppearance.AppCompat.Caption">
        <item name="android:fontFamily">@font/sandal</item>
    </style>

    <style name="CustomTextView" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/sandal</item>
    </style>

</resources>