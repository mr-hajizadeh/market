<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.BottomNavigationView</item>
    </style>

    <style name="ThemeOverlay.App.BottomNavigationView" parent="">
        <item name="colorSurface">@color/primary_gray</item>
        <item name="colorOnSecondaryContainer">@color/green</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorOnSurface">@color/green</item>
        <item name="itemTextAppearanceInactive">@style/CustomBottomNavTextAppearance</item>
        <item name="itemTextAppearanceActive">@style/CustomBottomNavTextAppearance</item>
    </style>

    <style name="CustomBottomNavTextAppearance" parent="TextAppearance.AppCompat.Caption">
        <item name="android:fontFamily">@font/sandal</item>
    </style>

    <style name="CustomTextView" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/sandal</item>
    </style>

    <style name="ThemeOverlay.App.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/ModalBottomSheetDialog</item>
    </style>

    <style name="ModalBottomSheetDialog" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/white</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.LargeComponent</item>
    </style>

    <style name="ShapeAppearance.App.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="customNavigateButton">
        <item name="android:background">@drawable/button_bg</item>
        <item name="android:padding">4dp</item>
    </style>

    <style name="customTextTitle">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/title_size</item>
    </style>

    <style name="customTextSubtitle">
        <item name="android:textSize">@dimen/sub_title_size</item>
    </style>

</resources>