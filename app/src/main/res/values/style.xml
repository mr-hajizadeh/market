<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.BottomNavigationView</item>
    </style>

    <style name="ThemeOverlay.App.BottomNavigationView" parent="">
        <item name="colorSurface">@color/primary_gray</item>
        <item name="colorOnSecondaryContainer">@color/green</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorOnSurface">@color/green</item>
        <item name="itemTextAppearanceInactive">@style/CustomBottomNavTextAppearance</item>
        <item name="itemTextAppearanceActive">@style/CustomBottomNavTextAppearance</item>
    </style>

    <style name="CustomBottomNavTextAppearance" parent="TextAppearance.AppCompat.Caption">
        <item name="android:fontFamily">@font/vazir</item>
    </style>

    <style name="CustomTextView" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/vazir</item>
    </style>

    <style name="CustomRadioButton" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:fontFamily">@font/vazir</item>
    </style>

    <style name="ThemeOverlay.App.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/ModalBottomSheetDialog</item>
    </style>

    <style name="ModalBottomSheetDialog" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/white</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.LargeComponent</item>
    </style>

    <style name="ShapeAppearance.App.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="customNavigateButton">
        <item name="android:background">@drawable/outline_bg</item>
        <item name="android:padding">4dp</item>
    </style>

    <style name="customTextTitle">
        <item name="android:textColor">@color/black</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.TitleMedium</item>
    </style>

    <style name="customTextSubtitle">
        <item name="android:textAppearance">@style/TextAppearance.Material3.LabelSmall</item>
        <item name="android:textColor">@color/text_color</item>
    </style>

    <style name="roundedImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="logoStyle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">32dp</item>
    </style>

    <style name="roundedImageView2">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="radioButtonImageRounded">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="productImageStyle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
    </style>

    <style name="outlineEditText">
        <item name="android:background">@drawable/input_stroke_bg</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.BodySmall</item>
        <item name="android:paddingHorizontal" tools:ignore="NewApi">10dp</item>
        <item name="android:paddingVertical" tools:ignore="NewApi">10dp</item>
        <item name="android:fontFamily">@font/vazir</item>
    </style>

    <style name="fillEditText">
        <item name="android:background">@drawable/input_bg</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.BodySmall</item>
        <item name="android:paddingHorizontal" tools:ignore="NewApi">10dp</item>
        <item name="android:paddingVertical" tools:ignore="NewApi">10dp</item>
        <item name="android:fontFamily">@font/vazir</item>
    </style>

    <style name="labelTextView">
        <item name="android:textAppearance">@style/TextAppearance.Material3.BodySmall</item>
    </style>

    <style name="SmallMaterialButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">32dp</item>
        <item name="android:minWidth">80dp</item>
        <item name="android:paddingVertical" tools:ignore="NewApi">4dp</item>
        <item name="android:paddingHorizontal" tools:ignore="NewApi">8dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.BodySmall</item>
    </style>


</resources>